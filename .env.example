# --- Database (Postgres) ---
# On Netlify, Netlify DB sets NETLIFY_DATABASE_URL automatically; leave DATABASE_URL unset.
# Set DATABASE_URL to use any other Postgres (local, Neon, Supabase, RDS, Cloud SQL...).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Auth (Clerk: dashboard.clerk.com → API keys) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Your site origin(s), comma-separated; rejects tokens minted for other sites
CLERK_AUTHORIZED_PARTIES=https://your-site.netlify.app
# Clerk user id (user_...) that always gets the admin role
OWNER_CLERK_USER_ID=

# --- LLM (any OpenAI-compatible /chat/completions endpoint) ---
# e.g. https://generativelanguage.googleapis.com/v1beta/openai/chat/completions with LLM_MODEL=gemini-2.5-flash
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# --- Legacy Manus proxy (only used when LLM_API_URL is empty / not on Netlify) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
