# Nothing is required on Netlify: the database (Netlify Database) and file
# storage (Netlify Blobs) are provisioned automatically, and migrations in
# netlify/database/migrations are applied on every deploy.

# Optional: use any other Postgres instead (local, Neon, Supabase, RDS, ...).
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional: workspace granted the admin role — "anon_" + your itcp_workspace cookie value.
# OWNER_OPEN_ID=

# Optional: Google sign-in. Without it everyone uses an anonymous workspace per browser.
# In Google Cloud Console add the authorized redirect URI <site origin>/api/auth/google/callback
# (e.g. https://import-export.josefmass.com/api/auth/google/callback, http://localhost:3000/api/auth/google/callback).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=          # signs the session cookie; any long random string
# OWNER_EMAIL=             # Google account granted the admin role

# Optional: site-wide AI enhancement (any OpenAI-compatible API; OpenRouter by default).
# Without it everything works from official data and rules, and testers can still
# connect their own local Ollama from the AI settings in the app.
# LLM_API_KEY=
# LLM_API_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.5-flash
# AI_DAILY_LIMIT=100
